{
  "productName": "Open Assistant QA Offline",
  "identifier": "com.openassistant.windows.qa",
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "Open Assistant QA Offline",
        "width": 1440,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true
      }
    ]
  }
}
